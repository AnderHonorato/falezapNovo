const express = require('express');
const router = express.Router();
const prisma = require('@prisma/client').PrismaClient();
const whatsappServico = require('../modelos/whatsappOfficialServico');

// Listar conversas
router.get('/', async (req, res) => {
  const { empresaId } = req.query;
  const conversas = await prisma.conversa.findMany({
    where: { empresaId: parseInt(empresaId) }
  });
  res.json(conversas);
});

// Enviar texto
router.post('/enviar-texto', async (req, res) => {
  const { empresaId, conversaId, mensagem } = req.body;
  const conversa = await prisma.conversa.findUnique({ where: { id: conversaId } });
  if (!conversa || conversa.empresaId !== empresaId) return res.status(403).json({ error: 'Acesso negado' });

  try {
    await whatsappServico.enviarTexto(empresaId, conversa.numeroCliente, mensagem);
    res.json({ success: true });
  } catch (err) {
    res.json({ success: false, error: err.message });
  }
});

// Enviar template
router.post('/enviar-template', async (req, res) => {
  const { empresaId, conversaId, nomeTemplate, variaveis } = req.body;
  const conversa = await prisma.conversa.findUnique({ where: { id: conversaId } });
  if (!conversa || conversa.empresaId !== empresaId) return res.status(403).json({ error: 'Acesso negado' });

  try {
    await whatsappServico.enviarTemplate(empresaId, conversa.numeroCliente, nomeTemplate, variaveis);
    res.json({ success: true });
  } catch (err) {
    res.json({ success: false, error: err.message });
  }
});

module.exports = router;
