datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Empresa {
  id        Int        @id @default(autoincrement())
  nome      String
  cnpj      String
  numeros   NumeroWhatsApp[]
  usuarios  Usuario[]
  conversas Conversa[]
  templates Template[]
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  role      String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  empresaId Int
}

model NumeroWhatsApp {
  id             Int      @id @default(autoincrement())
  phoneNumberId  String
  accessToken    String
  status         String
  empresa        Empresa  @relation(fields: [empresaId], references: [id])
  empresaId      Int
}

model Conversa {
  id                   Int       @id @default(autoincrement())
  numeroCliente        String
  status               String
  ultimaMensagemEnv    DateTime?
  ultimaMensagemRec    DateTime?
  empresa              Empresa   @relation(fields: [empresaId], references: [id])
  empresaId            Int
  mensagens            Mensagem[]
}

model Mensagem {
  id           Int      @id @default(autoincrement())
  tipo         String
  direcao      String
  payload      String
  timestamp    DateTime @default(now())
  conversa     Conversa @relation(fields: [conversaId], references: [id])
  conversaId   Int
}

model Template {
  id         Int      @id @default(autoincrement())
  nome       String
  linguagem  String
  body       String
  header     String?
  footer     String?
  botoes     String?   // JSON array de botões
  status     String
  empresa    Empresa   @relation(fields: [empresaId], references: [id])
  empresaId  Int
}


// backend/src/modelos/whatsappOfficialServico.js
const axios = require('axios');
const { PrismaClient } = require('@prisma/client');
const prisma = new PrismaClient();

class WhatsAppServico {
  constructor() {}

  async enviarTexto(empresaId, numeroCliente, mensagem) {
    const numero = await prisma.numerosWhatsApp.findFirst({
      where: { empresaId, status: 'ativo' }
    });

    if (!numero) throw new Error('Número WhatsApp da empresa não configurado');

    const url = `https://graph.facebook.com/v21.0/${numero.phoneNumberId}/messages`;

    const payload = {
      messaging_product: 'whatsapp',
      to: numeroCliente,
      type: 'text',
      text: { body: mensagem }
    };

    return axios.post(url, payload, {
      headers: { Authorization: `Bearer ${numero.accessToken}` }
    });
  }

  async enviarTemplate(empresaId, numeroCliente, nomeTemplate, variaveis = []) {
    const numero = await prisma.numerosWhatsApp.findFirst({
      where: { empresaId, status: 'ativo' }
    });
    if (!numero) throw new Error('Número WhatsApp da empresa não configurado');

    const payload = {
      messaging_product: 'whatsapp',
      to: numeroCliente,
      type: 'template',
      template: {
        name: nomeTemplate,
        language: { code: 'pt_BR' },
        components: [
          { type: 'body', parameters: variaveis.map(v => ({ type: 'text', text: v })) }
        ]
      }
    };

    return axios.post(
      `https://graph.facebook.com/v21.0/${numero.phoneNumberId}/messages`,
      payload,
      { headers: { Authorization: `Bearer ${numero.accessToken}` } }
    );
  }
}

module.exports = new WhatsAppServico();

