// dashboard.js
// Funções básicas para listar conversas e enviar mensagens
// Supõe que seu backend já tem endpoints: /conversas, /enviar-texto, /enviar-template

const empresaId = 1; // Exemplo fixo, em produção pegar do login do usuário

// Elementos do DOM
const divConversas = document.getElementById('conversas');

// Função para buscar conversas
async function carregarConversas() {
  try {
    const res = await fetch(`/conversas?empresaId=${empresaId}`);
    const conversas = await res.json();

    divConversas.innerHTML = '';
    conversas.forEach(c => {
      const div = document.createElement('div');
      div.classList.add('conversa');
      div.innerHTML = `
        <strong>Cliente:</strong> ${c.numeroCliente} <br>
        <strong>Status:</strong> ${c.status} <br>
        <input type="text" id="msg-${c.id}" placeholder="Digite uma mensagem"/>
        <button onclick="enviarTexto(${c.id})">Enviar Texto</button>
        <button onclick="enviarTemplate(${c.id})">Enviar Template</button>
      `;
      divConversas.appendChild(div);
    });
  } catch (err) {
    console.error('Erro ao carregar conversas:', err);
  }
}

// Função para enviar texto
async function enviarTexto(conversaId) {
  const input = document.getElementById(`msg-${conversaId}`);
  const mensagem = input.value.trim();
  if (!mensagem) return alert('Digite uma mensagem');

  try {
    const res = await fetch('/conversas/enviar-texto', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        empresaId,
        conversaId,
        mensagem
      })
    });
    const data = await res.json();
    if (data.success) {
      alert('Mensagem enviada!');
      input.value = '';
      carregarConversas();
    } else {
      alert('Erro ao enviar: ' + data.error);
    }
  } catch (err) {
    console.error('Erro ao enviar texto:', err);
  }
}

// Função para enviar template
async function enviarTemplate(conversaId) {
  const variaveis = prompt('Digite os valores das variáveis do template separados por vírgula');
  const varsArray = variaveis ? variaveis.split(',').map(v => v.trim()) : [];

  try {
    const res = await fetch('/conversas/enviar-template', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        empresaId,
        conversaId,
        nomeTemplate: 'inicio_conversa', // template de exemplo
        variaveis: varsArray
      })
    });
    const data = await res.json();
    if (data.success) alert('Template enviado!');
    else alert('Erro ao enviar template: ' + data.error);
  } catch (err) {
    console.error('Erro ao enviar template:', err);
  }
}

