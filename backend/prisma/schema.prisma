model WhatsAppInstancia {
  id                    String                 @id @default(cuid())
  contaId               String
  empresaId             String?
  usuarioId             String
  nome                  String
  numero                String?
  status                String                 @default("DESCONECTADO")
  qrCode                String?
  conectadoEm           DateTime?
  desconectadoEm        DateTime?
