  atualizadoEm         DateTime           @updatedAt
  instancia            WhatsAppInstancia  @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
  usuarioResponsavel   Usuario?           @relation(fields: [usuarioResponsavelId], references: [id])
  mensagens            MensagemWhatsApp[]

  @@unique([instanciaId, numero])
  @@index([instanciaId])
  @@index([usuarioResponsavelId])
