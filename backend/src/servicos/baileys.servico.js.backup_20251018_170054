      for (const update of updates) {
        const { key, update: msgUpdate } = update;

        const mensagem = await prisma.mensagem.findUnique({
          where: { whatsappId: key.id }
        });

        if (mensagem) {
          let novoStatus = mensagem.status;

          if (msgUpdate.status === 2) {
            novoStatus = 'entregue';
          } else if (msgUpdate.status === 3) {
            novoStatus = 'lida';
          }

          if (novoStatus !== mensagem.status) { // Só atualiza se o status mudou
            await prisma.mensagem.update({
              where: { whatsappId: key.id },
              data: {
                status: novoStatus,
                entregue: msgUpdate.status >= 2,
                lida: msgUpdate.status === 3
              }
            });
          }
        }
      }
    } catch (erro) {
      console.error('Erro ao atualizar status:', erro.message);
    }
  }

