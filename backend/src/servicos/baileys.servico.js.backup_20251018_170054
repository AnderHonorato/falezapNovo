// --- IMPORTAÇÕES ADICIONAIS ---
const { default: makeWASocket, useMultiFileAuthState, DisconnectReason, fetchLatestBaileysVersion, makeCacheableSignalKeyStore, isJidBroadcast, downloadMediaMessage } = require('@whiskeysockets/baileys'); // Adicionado downloadMediaMessage
const { Boom } = require('@hapi/boom');
const fs = require('fs'); // Adicionado fs
const path =require('path'); // Adicionado path
const pino = require('pino');
const NodeCache = require('node-cache');
const QRCode = require('qrcode');
const { PrismaClient } = require('@prisma/client');
const crypto = require('crypto'); // Para gerar nomes de arquivo únicos

const prisma = new PrismaClient();

// Define o diretório de uploads (fora da classe para ser acessível)
const UPLOADS_DIR = path.join(__dirname, '../../uploads');
// Garante que o diretório exista
if (!fs.existsSync(UPLOADS_DIR)) {
  fs.mkdirSync(UPLOADS_DIR, { recursive: true });
}

class ServicoWhatsApp {
  constructor() {
    this.clientes = {};
    this.clientesWS = {};
    this.tentativasReconexao = {};
    this.caminhoAuth = path.join(__dirname, '../../dados_whatsapp');

    if (!fs.existsSync(this.caminhoAuth)) {
      fs.mkdirSync(this.caminhoAuth, { recursive: true });
    }

    console.log('✅ ServicoWhatsApp inicializado');
  }

  obterCaminhoAutenticacao(usuarioId, empresaId) {
    return path.join(this.caminhoAuth, `${empresaId}_${usuarioId}`);
  }

  registrarClienteWS(usuarioId, res) {
    console.log(`📡 Cliente registrado: ${usuarioId}`);
    this.clientesWS[usuarioId] = res;
  }

  enviarQRCodeParaCliente(usuarioId, qrDataURL) {
    const res = this.clientesWS[usuarioId];
    if (res && !res.headersSent) {
      console.log(`📤 Enviando QR Code`);
      try {
        res.json({
          sucesso: true,
          qrCode: qrDataURL,
          mensagem: 'Escaneie o QR Code'
        });
      } catch (e) {
        console.error('Erro ao enviar QR:', e.message);
      }
      delete this.clientesWS[usuarioId];
    }
  }

  async reconectar(usuarioId, empresaId, tentativa = 0) {
    const maxTentativas = 3;
    if (tentativa >= maxTentativas) {
      console.log(`❌ Máximo de tentativas atingido para ${usuarioId}`);
      return;
    }

    console.log(`🔄 Tentativa de reconexão ${tentativa + 1}/${maxTentativas}`);
    await new Promise(resolve => setTimeout(resolve, 3000));

    try {
      await this.conectarWhatsApp(usuarioId, empresaId);
    } catch (erro) {
      console.error(`❌ Erro na reconexão:`, erro.message);
    }
  }

  async conectarWhatsApp(usuarioId, empresaId) {
    try {
      console.log(`\n🔄 Conectando WhatsApp para ${usuarioId}...`);

      const caminhoAuth = this.obterCaminhoAutenticacao(usuarioId, empresaId);

      if (!fs.existsSync(caminhoAuth)) {
        fs.mkdirSync(caminhoAuth, { recursive: true });
      }

      if (this.clientes[usuarioId]) {
        try {
          await this.clientes[usuarioId].socket?.end();
          await this.clientes[usuarioId].socket?.ws?.close();
        } catch (e) {
          console.log('Limpando conexão anterior...');
        }
        delete this.clientes[usuarioId];
      }

      const { state, saveCreds } = await useMultiFileAuthState(caminhoAuth);
      const { version } = await fetchLatestBaileysVersion();

      console.log(`📱 Baileys versão: ${version.join('.')}`);

      const msgRetryCounterCache = new NodeCache();

      const socket = makeWASocket({
        version,
        logger: pino({ level: 'silent' }),
        printQRInTerminal: false,
        browser: ['FaleZap', 'Chrome', '120.0.0'],
        auth: {
          creds: state.creds,
          keys: makeCacheableSignalKeyStore(state.keys, pino({ level: 'silent' })),
        },
        markOnlineOnConnect: true,
        syncFullHistory: false,
        generateHighQualityLinkPreview: false,
        shouldIgnoreJid: (jid) => isJidBroadcast(jid),
        emitOwnEvents: false,
        getMessage: async (key) => {
          const msg = await prisma.mensagem.findUnique({
            where: { whatsappId: key.id }
          });
          // @ts-ignore
          return msg ? { message: { conversation: msg.conteudo } } : undefined;
        },
        msgRetryCounterCache,
        defaultQueryTimeoutMs: undefined,
        connectTimeoutMs: undefined,
        keepAliveIntervalMs: 10000,
        retryRequestDelayMs: 250,
        maxRetries: 10,
        qrTimeout: 60000
      });

      console.log(`✅ Socket criado`);

      socket.ev.on('creds.update', saveCreds);

      let qrEnviado = false;
      let qrCount = 0;

      socket.ev.on('connection.update', async (update) => {
        const { connection, lastDisconnect, qr } = update;

        if (qr && !qrEnviado) {
          qrCount++;
          console.log(`\n✨ QR CODE GERADO! (${qrCount})`);

          try {
            const qrDataURL = await QRCode.toDataURL(qr, {
              errorCorrectionLevel: 'H',
              type: 'image/png',
              width: 400,
              margin: 2,
              color: {
                dark: '#000000',
                light: '#FFFFFF'
              }
            });

            this.clientes[usuarioId] = {
              socket: socket,
              estado: 'aguardando_qr',
              empresaId: empresaId,
              qrGerado: new Date(),
            };

            this.enviarQRCodeParaCliente(usuarioId, qrDataURL);
            qrEnviado = true;
            console.log(`✅ QR Code enviado`);

          } catch (erro) {
            console.error(`❌ Erro ao converter QR:`, erro.message);
          }
        }

        if (connection === 'connecting') {
          console.log(`🔄 Conectando...`);
        }

        if (connection === 'open') {
          console.log(`\n✅ WHATSAPP CONECTADO!\n`);
          console.log(`📱 Número: ${socket.user?.id || 'Desconhecido'}`);

          qrEnviado = false;
          qrCount = 0;
          delete this.tentativasReconexao[usuarioId];

          this.clientes[usuarioId] = {
            socket: socket,
            estado: 'conectado',
            empresaId: empresaId,
            conectadoEm: new Date(),
            numero: socket.user?.id || 'desconhecido',
            nome: socket.user?.name || 'Sem nome',
          };

          try {
            await socket.sendPresenceUpdate('available');
          } catch (e) {
            console.log('Erro ao atualizar presença:', e.message);
          }

          console.log('🔄 Aguardando 3 segundos...');
          setTimeout(async () => {
            await this.sincronizarHistoricoSimplificado(usuarioId, empresaId, socket);
          }, 3000);
        }

        if (connection === 'close') {
          const statusCode = new Boom(lastDisconnect?.error)?.output?.statusCode;
          const shouldReconnect = statusCode !== DisconnectReason.loggedOut;

          console.log(`\n⚠️ Desconectado - Código: ${statusCode}`);

          delete this.clientes[usuarioId];

          if (statusCode === DisconnectReason.loggedOut) {
            console.log(`🔴 Logout detectado`);
            try {
              fs.rmSync(caminhoAuth, { recursive: true, force: true });
            } catch (e) {
              console.error('Erro ao limpar:', e.message);
            }
            delete this.tentativasReconexao[usuarioId];
          }
          else if (shouldReconnect && statusCode !== DisconnectReason.timedOut) {
            const tentativas = this.tentativasReconexao[usuarioId] || 0;
            this.tentativasReconexao[usuarioId] = tentativas + 1;

            await this.reconectar(usuarioId, empresaId, tentativas);
          }
        }
      });

      socket.ev.on('messages.upsert', async ({ messages }) => {
        await this.processarMensagensRecebidas(usuarioId, empresaId, messages, socket);
      });

      socket.ev.on('messages.update', async (updates) => {
        await this.atualizarStatusMensagens(updates);
      });

      return socket;

    } catch (erro) {
      console.error(`❌ Erro ao conectar:`, erro.message);
      delete this.clientes[usuarioId];
      throw erro;
    }
  }

  async sincronizarHistoricoSimplificado(usuarioId, empresaId, socket) {
    try {
      console.log('🔄 Sincronizando...');

      const usuario = await prisma.usuario.findUnique({
        where: { id: usuarioId },
        include: { conta: true }
      });

      if (!usuario) {
        console.log('⚠️ Usuário não encontrado');
        return;
      }

      const contaId = usuario.contaId;

      let conexao = await prisma.conexaoWhatsApp.findFirst({
        where: {
          contaId: contaId,
          numeroWhatsApp: socket.user?.id || 'desconhecido'
        }
      });

      if (!conexao) {
        conexao = await prisma.conexaoWhatsApp.create({
          data: {
            numeroWhatsApp: socket.user?.id || 'desconhecido',
            nomeExibicao: socket.user?.name,
            status: 'CONECTADO',
            contaId: contaId
          }
        });
      }

      console.log('✅ Conexão registrada');

    } catch (erro) {
      console.error('❌ Erro:', erro.message);
    }
  }

// --- ATUALIZADO processarMensagensRecebidas (para IGNORAR reações) ---
// backend/src/servicos/baileys.servico.js

async processarMensagensRecebidas(usuarioId, empresaId, messages, socket, isSincronizacao = false) {
    try {
      const usuario = await prisma.usuario.findUnique({ where: { id: usuarioId }, include: { conta: true } });
      if (!usuario) return;
      const contaId = usuario.contaId;

      for (const msg of messages) {
        try {
          if (msg.key.fromMe && !isSincronizacao) continue;

          const remetente = msg.key.remoteJid;
          const isGrupo = remetente.endsWith('@g.us');
          const whatsappId = msg.key.id;

          // Evita processar a mesma mensagem duas vezes (se evento chegar rápido)
          const existe = await prisma.mensagem.findUnique({ where: { whatsappId: whatsappId } });
          if (existe) {
              // console.log(`Msg ${whatsappId} já existe, pulando.`);
              continue;
          }
          
          const { conteudo, tipo, midiaNome, legendaImagem, mensagemCitada, originalMessage, reactionToKey } = this.extrairConteudoMensagem(msg);

          if (tipo === 'REACAO' && !reactionToKey) {
             console.warn(`Reação recebida sem reactionToKey: ${whatsappId}. Ignorando.`);
             continue; // Ignora se não souber a qual mensagem reagir
          }
          if (tipo === 'REACAO') {
            console.log(`👍 Reação '${conteudo}' recebida para msg WA ID: ${reactionToKey?.id}. Salvando...`);
          }

          let conexao = await prisma.conexaoWhatsApp.findFirst({ where: { contaId: contaId, numeroWhatsApp: socket.user?.id || 'desconhecido' } });
          if (!conexao) {
             conexao = await prisma.conexaoWhatsApp.create({ data: { numeroWhatsApp: socket.user?.id || 'desconhecido', nomeExibicao: socket.user?.name, status: 'CONECTADO', contaId: contaId } });
          }

          let conversa = await prisma.conversa.findFirst({ where: { contaId: contaId, numeroCliente: remetente } });
          let statusConversa = 'CAIXA_ENTRADA';
          if (conversa) {
             if (!msg.key.fromMe && conversa.statusConversa === 'FINALIZADA' && tipo !== 'REACAO') { statusConversa = 'CAIXA_ENTRADA'; }
             else { statusConversa = conversa.statusConversa; }
          } else {
             let nomeCliente = msg.pushName || remetente.split('@')[0];
             let nomeGrupo = null;
             if (isGrupo) { try { const metadata = await socket.groupMetadata(remetente); nomeGrupo = metadata.subject; nomeCliente = nomeGrupo; } catch (e) { console.log('Erro ao buscar metadata:', e.message); } }
             conversa = await prisma.conversa.create({ data: { numeroCliente: remetente, nomeCliente: nomeCliente, isGrupo: isGrupo, nomeGrupo: nomeGrupo, statusConversa: statusConversa, conexaoWhatsAppId: conexao.id, contaId: contaId } });
          }

          let nomeRemetente = msg.pushName || remetente.split('@')[0];
          let participantVar = null; 
          let participantNomeVar = null;
          if (isGrupo) {
             participantVar = msg.key.participant;
             if(participantVar) {
                 participantNomeVar = msg.pushName || participantVar.split('@')[0];
             }
          }
          let dadosMensagemCitada = {};
          if (mensagemCitada) { let autorCitado = mensagemCitada.participante || mensagemCitada.autorJid; let nomeAutorCitado = autorCitado?.split('@')[0]; if (autorCitado === socket.user?.id.split(':')[0] + '@s.whatsapp.net') { nomeAutorCitado = 'Você'; } else if (isGrupo && conversa.nomeGrupo) { nomeAutorCitado = `+${autorCitado?.split('@')[0].substring(0, 12)}`; } else { nomeAutorCitado = conversa.nomeCliente; } dadosMensagemCitada = { mensagemCitadaAutor: nomeAutorCitado, mensagemCitadaConteudo: mensagemCitada.conteudo }; }

          // Lógica de Download e URL (sem alterações)
          let midiaUrl = null;
          const tiposComMidia = ['IMAGEM', 'VIDEO', 'AUDIO', 'DOCUMENTO', 'FIGURINHA'];
          if (tiposComMidia.includes(tipo) && originalMessage) { 
              try { 
                  console.log(`⬇️ Baixando mídia tipo ${tipo} para msg ID: ${whatsappId}`);
                  const buffer = await downloadMediaMessage( msg, 'buffer', {}, { logger: pino({ level: 'silent' }), reuploadRequest: socket.updateMediaMessage });
                  const extensao = this.getExtensaoPorTipo(tipo, msg);
                  const nomeArquivo = `${crypto.randomBytes(16).toString('hex')}${extensao}`;
                  const caminhoArquivo = path.join(UPLOADS_DIR, nomeArquivo);
                  await fs.promises.writeFile(caminhoArquivo, buffer);
                  const baseUrl = process.env.BASE_URL || `http://localhost:${process.env.PORT || 3000}`;
                  midiaUrl = `${baseUrl}/uploads/${nomeArquivo}`;
                  console.log(`✅ Mídia salva: ${midiaUrl}`);
              } catch (downloadError) { console.error(`❌ Erro ao baixar/salvar mídia para msg ID ${whatsappId}:`, downloadError); }
           }

          // Lógica de timestamp (sem alterações)
          let timestampSegundos;
          if (typeof msg.messageTimestamp === 'number') { timestampSegundos = msg.messageTimestamp; }
          else if (typeof msg.messageTimestamp === 'object' && msg.messageTimestamp !== null && typeof msg.messageTimestamp.low === 'number') { timestampSegundos = msg.messageTimestamp.low; }
          else { console.warn(`[ServicoWhatsApp] Timestamp ausente ou inválido para msg ID: ${whatsappId}. Usando Date.now(). MSG:`, msg); timestampSegundos = Math.floor(Date.now() / 1000); }
          const timestampMsNumber = timestampSegundos * 1000;
          const dataMensagem = new Date(timestampMsNumber);
          const timestampMsBigInt = BigInt(timestampSegundos) * BigInt(1000);

          // --- CORREÇÃO: Define replyParaId APENAS para RESPOSTAS, não reações ---
          let replyParaIdOriginal = null;
          if (mensagemCitada) { // Se for uma resposta (reply)
            // Tenta encontrar o ID interno (UUID) da mensagem citada
            const msgCitadaNoDb = await prisma.mensagem.findUnique({ 
              where: { whatsappId: mensagemCitada.id },
              select: { id: true } // Seleciona apenas o ID
            });
            if (msgCitadaNoDb) {
              replyParaIdOriginal = msgCitadaNoDb.id;
              console.log(`   🔗 Linkando resposta ${whatsappId} para msg original UUID: ${replyParaIdOriginal}`);
            } else {
              console.warn(`   ⚠️ Mensagem citada (${mensagemCitada.id}) não encontrada no DB para linkar resposta ${whatsappId}.`);
            }
          }
          // --- FIM CORREÇÃO ---

          await prisma.mensagem.create({
            data: {
              whatsappId: whatsappId,
              conteudo: conteudo,
              tipo: tipo,
              direcao: msg.key.fromMe ? 'ENVIADA' : 'RECEBIDA',
              lida: msg.key.fromMe ? true : false,
              midiaUrl: midiaUrl,
              midiaNome: midiaNome || (midiaUrl ? midiaUrl.split('/').pop() : null),
              legendaImagem: legendaImagem,
              remetenteNome: nomeRemetente, // Nome de quem enviou a msg/reação
              participant: participantVar,      
              participantNome: participantNomeVar, 
              status: 'enviada',
              timestamp: timestampMsBigInt,
              conversaId: conversa.id,
              contaId: contaId,
              enviadaEm: dataMensagem,
              // Campos de Reply (resposta)
              replyParaId: replyParaIdOriginal, // <<< CORRIGIDO: Só preenche se for resposta
              mensagemCitadaAutor: dadosMensagemCitada.mensagemCitadaAutor || null,
              mensagemCitadaConteudo: dadosMensagemCitada.mensagemCitadaConteudo || null,
              // --- CORREÇÃO: Salva o whatsappId da msg original para REAÇÕES ---
              reactionToWhatsappId: tipo === 'REACAO' ? reactionToKey?.id : null // <<< CORRIGIDO
            }
          });

          // Não atualiza a conversa se for apenas uma reação
          if (tipo !== 'REACAO') {
            await prisma.conversa.update({ 
              where: { id: conversa.id }, 
              data: { 
                ultimaMensagemEm: dataMensagem, 
                naoLidas: !msg.key.fromMe ? { increment: 1 } : undefined, 
                statusConversa: statusConversa, 
                nomeCliente: (isGrupo ? conversa.nomeCliente : nomeRemetente) 
              } 
            });
          }

          if (!isSincronizacao && tipo !== 'REACAO') { 
            console.log(`💬 Mensagem: ${nomeRemetente} - ${conteudo.substring(0, 30)}...`); 
          }

        } catch (erro) { console.error('Erro ao processar mensagem:', erro.message, `WA_ID: ${msg?.key?.id}`); }
      }
    } catch (erro) { console.error('❌ Erro geral em processarMensagensRecebidas:', erro.message); }
}
  
  // --- ATUALIZADO extrairConteudoMensagem (Corrigido o typo 'msgPanel' e adicionado 'reactionToKey') ---
  extrairConteudoMensagem(msg) {
    let conteudo = '';
    let tipo = 'DESCONHECIDO'; // <<< Começa com DESCONHECIDO como fallback
    let midiaUrl = null; // Removido daqui, será gerado após download
    let midiaNome = null;
    let legendaImagem = null;
    let mensagemCitada = null;
    let originalMessage = msg.message; // Guarda a mensagem original
    let reactionToKey = null; // <<< NOVO: Para guardar a key da msg reagida

    // --- Tratamento para Mensagem Efêmera ---
    if (originalMessage?.ephemeralMessage) {
        console.log("Processando mensagem efêmera...");
        originalMessage = originalMessage.ephemeralMessage.message;
    }
    // --- Fim Tratamento Efêmera ---

    // Define msgPrincipal para originalMessage (pode ter sido atualizado pelo bloco acima)
    const msgPrincipal = originalMessage;

    // --- Tratamento para Reação ---
    if (msgPrincipal?.reactionMessage) {
        conteudo = msgPrincipal.reactionMessage.text || '❤️'; // Pega o emoji da reação
        tipo = 'REACAO'; // <<< NOVO TIPO
        reactionToKey = msgPrincipal.reactionMessage.key; // <<< CAPTURA A KEY
    // --- Fim Tratamento Reação ---

    // --- Lógica Principal para Tipos de Conteúdo ---
    } else if (msgPrincipal?.conversation) {
      conteudo = msgPrincipal.conversation;
      tipo = 'TEXTO';
    } else if (msgPrincipal?.extendedTextMessage?.text) {
      conteudo = msgPrincipal.extendedTextMessage.text;
      tipo = 'TEXTO';
    } else if (msgPrincipal?.imageMessage) {
      conteudo = msgPrincipal.imageMessage.caption || '📷 Imagem';
      legendaImagem = msgPrincipal.imageMessage.caption;
      tipo = 'IMAGEM';
    } else if (msgPrincipal?.videoMessage) {
      conteudo = msgPrincipal.videoMessage.caption || '🎥 Vídeo';
      legendaImagem = msgPrincipal.videoMessage.caption;
      tipo = 'VIDEO';
    } else if (msgPrincipal?.documentMessage) {
      conteudo = `📄 ${msgPrincipal.documentMessage.fileName || 'Documento'}`;
      midiaNome = msgPrincipal.documentMessage.fileName;
      tipo = 'DOCUMENTO';
    } else if (msgPrincipal?.audioMessage) {
      conteudo = '🎵 Áudio';
      tipo = 'AUDIO';
    } else if (msgPrincipal?.stickerMessage) {
      conteudo = '🎨 Figurinha';
      tipo = 'FIGURINHA';
    } else if (msgPrincipal?.locationMessage) {
      conteudo = '📍 Localização';
      tipo = 'LOCALIZACAO';
    } else if (msgPrincipal?.contactMessage) {
      conteudo = '👤 Contato';
      tipo = 'CONTATO';
    } else if (msgPrincipal?.pollCreationMessageV3) {
      conteudo = `📊 Enquete: ${msgPrincipal.pollCreationMessageV3.name}`;
      tipo = 'ENQUETE';
    } else if (msg.messageStubType) {
      // Mensagens de evento de grupo (entrou, saiu, etc)
      conteudo = `Evento de grupo: ${msg.messageStubType}`;
      tipo = 'EVENTO';
    } else if (!conteudo && msgPrincipal) {
        // Se nenhum tipo acima foi detectado, mas existe msgPrincipal
        console.warn("Tipo de mensagem não explicitamente tratado:", JSON.stringify(msgPrincipal).substring(0, 200));
        conteudo = 'Mensagem não suportada'; // Ou deixe vazio ''
        tipo = 'DESCONHECIDO'; // <<< Fallback final é DESCONHECIDO
    } else if (!msgPrincipal && !msg.messageStubType) {
        // Se não houver absolutamente nenhum conteúdo reconhecível
        conteudo = '';
        tipo = 'DESCONHECIDO'; // <<< Fallback final é DESCONHECIDO
    }
    // --- Fim Lógica Principal ---


    // --- Capturar mensagem citada (reply) ---
    // (Ajustado para buscar em msgPrincipal, que pode ter vindo da ephemeralMessage)
    
    // --- CORRIGIDO: msgPanel -> msgPrincipal ---
    const contextInfo = msgPrincipal?.extendedTextMessage?.contextInfo || msgPrincipal?.imageMessage?.contextInfo || msgPrincipal?.videoMessage?.contextInfo || msgPrincipal?.documentMessage?.contextInfo;
    
    if (contextInfo && contextInfo.quotedMessage) {
        const msgCitada = contextInfo.quotedMessage;
        let conteudoCitado = 'Mídia';

         if (msgCitada.conversation) { conteudoCitado = msgCitada.conversation; }
         else if (msgCitada.extendedTextMessage?.text) { conteudoCitado = msgCitada.extendedTextMessage.text; }
         else if (msgCitada.imageMessage) { conteudoCitado = msgCitada.imageMessage.caption || '📷 Imagem'; }
         else if (msgCitada.videoMessage) { conteudoCitado = msgCitada.videoMessage.caption || '🎥 Vídeo'; }
         else if (msgCitada.documentMessage) { conteudoCitado = `📄 ${msgCitada.documentMessage.fileName || 'Documento'}`; }

        mensagemCitada = {
            id: contextInfo.stanzaId,
            autorJid: contextInfo.participant,
            conteudo: conteudoCitado
        };
    }
    // --- Fim Capturar Reply ---

    // Retorna a mensagem original completa (para download) e os dados extraídos
    return { conteudo, tipo, midiaNome, legendaImagem, mensagemCitada, originalMessage: msg, reactionToKey }; // <<< CORRIGIDO: Retorna 'msg' original e 'reactionToKey'
  }


  // --- NOVA FUNÇÃO AUXILIAR ---
  getExtensaoPorTipo(tipo, msg) {
      // Tenta obter do mimetype primeiro, se disponível
      const msgPrincipal = msg?.message; // Adiciona verificação se msg existe
      let mimetype = msgPrincipal?.imageMessage?.mimetype ||
                     msgPrincipal?.videoMessage?.mimetype ||
                     msgPrincipal?.audioMessage?.mimetype ||
                     msgPrincipal?.documentMessage?.mimetype ||
                     msgPrincipal?.stickerMessage?.mimetype;

      if (mimetype) {
          const parts = mimetype.split('/');
          const subtype = parts[1]?.split(';')[0]; // Pega subtipo e remove parâmetros como '; codecs=opus'
          // Mapeamentos comuns
          if (subtype === 'jpeg') return '.jpg';
          if (subtype === 'png') return '.png';
          if (subtype === 'webp') return '.webp'; // Para figurinhas
          if (subtype === 'mp4') return '.mp4';
          if (subtype === 'ogg' || subtype === 'oga') return '.ogg'; // Para áudios PTT
          if (mimetype.startsWith('audio/aac')) return '.aac'; // Adicionado AAC
          if (subtype === 'mpeg') return '.mp3';
          if (subtype === 'pdf') return '.pdf';
          if (subtype === 'vnd.openxmlformats-officedocument.wordprocessingml.document') return '.docx';
          if (subtype === 'vnd.openxmlformats-officedocument.spreadsheetml.sheet') return '.xlsx';
          if (subtype === 'vnd.openxmlformats-officedocument.presentationml.presentation') return '.pptx'; // Adicionado PPTX
          if (subtype === 'msword') return '.doc';
          if (subtype === 'vnd.ms-excel') return '.xls';
          if (subtype === 'vnd.ms-powerpoint') return '.ppt'; // Adicionado PPT
          if (subtype === 'plain') return '.txt'; // Adicionado TXT

          // Se for um tipo conhecido, mas não mapeado, usa o subtipo
          if (['gif', 'tiff', 'avi', 'mov', 'wav', 'zip', 'rar'].includes(subtype)) return `.${subtype}`; // Adicionado zip/rar
      }

      // Fallback baseado no tipo principal (se tipo foi definido e não apenas DESCONHECIDO)
      switch (tipo) {
          case 'IMAGEM': return '.jpg'; // Fallback genérico
          case 'VIDEO': return '.mp4';
          case 'AUDIO': return '.ogg'; // Ogg é comum para áudio PTT
          case 'DOCUMENTO': return ''; // Difícil adivinhar, melhor depender do nome original se possível
          case 'FIGURINHA': return '.webp';
          default: return '';
      }
  }


  async atualizarStatusMensagens(updates) {
