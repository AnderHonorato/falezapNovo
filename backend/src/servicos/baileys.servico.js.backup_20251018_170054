async obterMensagensConversa(usuarioId, numeroCliente, limite = 50, offset = 0) {
    try {
      const usuario = await prisma.usuario.findUnique({ where: { id: usuarioId } });
      if (!usuario) { return { total: 0, mensagens: [], temMais: false }; }
      const conversa = await prisma.conversa.findFirst({ where: { contaId: usuario.contaId, numeroCliente: numeroCliente } });
      if (!conversa) { return { total: 0, mensagens: [], temMais: false }; }

      // Total de mensagens NÃO-REAÇÃO na conversa inteira (para 'temMais')
      const totalMensagensNormais = await prisma.mensagem.count({ 
        where: { 
          conversaId: conversa.id,
          tipo: { not: 'REACAO' } 
        } 
      });

      // Busca o lote atual (incluindo reações)
      const mensagensDoBanco = await prisma.mensagem.findMany({
        where: { conversaId: conversa.id }, 
        orderBy: { enviadaEm: 'desc' },
        skip: offset,
        take: limite,
        select: {
            id: true, 
            whatsappId: true,
            conteudo: true,
            tipo: true,
            direcao: true,
            lida: true,
            midiaUrl: true,
            midiaNome: true,
            legendaImagem: true,
            remetenteNome: true,
            participant: true,
            participantNome: true,
            replyParaId: true, 
            reactionToWhatsappId: true, 
            mensagemCitadaAutor: true,
            mensagemCitadaConteudo: true,
            status: true,
            timestamp: true,
            enviadaEm: true,
            usuarioId: true,
            nomeUsuario: true
        }
      });

      // Mapeia para o formato do frontend
      const mensagensFormatadas = mensagensDoBanco.reverse().map(msg => ({
        id: msg.whatsappId,         
        internalId: msg.id,        
        de: msg.direcao === 'RECEBIDA' ? conversa.numeroCliente : 'eu',
        nome: conversa.nomeCliente, 
        participante: msg.participant,
        participantNome: msg.participantNome, 
        remetenteNome: msg.remetenteNome, 
        mensagem: msg.conteudo,
        data: msg.enviadaEm,
        timestamp: msg.timestamp ? Number(msg.timestamp) : null,
        tipo: msg.tipo.toLowerCase(),
        status: msg.status,
        direcao: msg.direcao,
        lida: msg.lida,
        midiaUrl: msg.midiaUrl,
        midiaNome: msg.midiaNome,
        legendaImagem: msg.legendaImagem,
        nomeUsuario: msg.nomeUsuario, 
        isGrupo: conversa.isGrupo,
        replyParaId: msg.replyParaId, 
        reactionToWhatsappId: msg.reactionToWhatsappId, 
        mensagemCitadaAutor: msg.mensagemCitadaAutor,
        mensagemCitadaConteudo: msg.mensagemCitadaConteudo
      }));

      // --- CORREÇÃO: Calcula 'temMais' corretamente ---
      // Conta quantas mensagens normais vieram NESTE lote
      const mensagensNormaisNesteLote = mensagensDoBanco.filter(m => m.tipo !== 'REACAO').length;
      // Calcula se há mais mensagens normais a carregar (baseado no total de mensagens normais)
      const temMais = (offset + mensagensNormaisNesteLote) < totalMensagensNormais; 
      // --- FIM CORREÇÃO ---

      // Retorna o total GERAL (incluindo reações, pode ser útil para info)
      const totalGeral = await prisma.mensagem.count({ where: { conversaId: conversa.id } });

      return { total: totalGeral, mensagens: mensagensFormatadas, temMais: temMais };
    } catch (erro) {
       console.error('❌ Erro ao obter mensagens da conversa:', erro); 
       return { total: 0, mensagens: [], temMais: false };
    }
  }
