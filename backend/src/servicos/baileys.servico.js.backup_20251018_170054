    try {
      const cliente = this.clientes[usuarioId];
      if (!cliente || cliente.estado !== 'conectado') {
        throw new Error('WhatsApp não conectado');
      }
      const socket = cliente.socket;

      let jid = numero;
      let numeroFormatado = '';
      let isGrupo = numero.endsWith('@g.us');

      if (!numero.includes('@')) {
        numeroFormatado = numero.replace(/\D/g, '');
        if (!numeroFormatado.startsWith('55') && numeroFormatado.length > 8) {
          numeroFormatado = '55' + numeroFormatado;
        }
        jid = numeroFormatado + '@s.whatsapp.net';
        isGrupo = false;
      } else {
        numeroFormatado = jid.split('@')[0];
      }

      console.log(`👍 Enviando reação ${emoji} para mensagem ${mensagemId} em ${jid}`);

      // Busca a mensagem original no banco (PARA PEGAR participant se for grupo)
      // Não precisamos mais do ID interno dela aqui, pois salvaremos reactionToWhatsappId
      const mensagemOriginal = await prisma.mensagem.findUnique({
        where: { whatsappId: mensagemId },
        select: {
          participant: true, // Necessário para a key em grupos
          direcao: true      // Necessário para fromMe na key
        }
      });

      if (!mensagemOriginal) {
        // Se a mensagem original não estiver no DB, ainda tenta enviar,
        // mas avisa, pois pode falhar em grupos se participant for necessário.
        console.warn(`   ⚠️ Mensagem original ${mensagemId} não encontrada no DB. Reação pode falhar em grupos.`);
      }

      // Monta a key da mensagem a ser reagida
      const key = {
        remoteJid: jid,
        id: mensagemId,
        fromMe: mensagemOriginal?.direcao === 'ENVIADA' // Define fromMe com base na direção da msg original
      };

      // Adiciona participant se for grupo E a mensagem original foi encontrada E tinha participant
      if (isGrupo && mensagemOriginal?.participant) {
        key.participant = mensagemOriginal.participant;
      }

      // Prepara a mensagem de reação para Baileys
      const reactionMessage = {
        react: {
          text: emoji,
          key: key
        }
      };

      // --- Envia a reação via Baileys ---
      const resultado = await cliente.socket.sendMessage(jid, reactionMessage);
      console.log(`✅ Reação enviada via WA (ID da reação: ${resultado.key.id})`);

      // --- SALVAR REAÇÃO ENVIADA NO BANCO DE DADOS ---
      try {
          const timestampMsg = resultado.messageTimestamp ?
            (typeof resultado.messageTimestamp === 'bigint' ?
              resultado.messageTimestamp :
              BigInt(resultado.messageTimestamp.low)
            ) : BigInt(Math.floor(Date.now() / 1000)); // Usar segundos se timestamp faltar
          const dataMensagem = new Date(Number(timestampMsg) * 1000);

          const usuario = await prisma.usuario.findUnique({ where: { id: usuarioId }, select: { contaId: true } }); // Pega contaId
          if (!usuario) throw new Error(`Usuário ${usuarioId} não encontrado para salvar reação.`);
          const contaId = usuario.contaId;

          const conexao = await prisma.conexaoWhatsApp.findFirst({
            where: { contaId: contaId, numeroWhatsApp: cliente.numero }
          });
          if (!conexao) throw new Error(`Conexão WhatsApp não encontrada para ${cliente.numero}`);

          let conversa = await prisma.conversa.findFirst({
            where: { contaId: contaId, numeroCliente: jid }
          });
          if (!conversa) {
             let nomeClienteInicial = isGrupo ? jid.split('@')[0] : numeroFormatado; // Nome provisório
             // Tenta buscar nome do grupo se for grupo
             if (isGrupo) {
                 try {
                     const metadata = await socket.groupMetadata(jid);
                     nomeClienteInicial = metadata.subject;
                 } catch (e) { console.warn("Não foi possível buscar nome do grupo ao criar conversa para reação."); }
             }
             conversa = await prisma.conversa.create({
               data: { numeroCliente: jid, nomeCliente: nomeClienteInicial, isGrupo: isGrupo, nomeGrupo: isGrupo ? nomeClienteInicial : null, statusConversa: 'CAIXA_ENTRADA', conexaoWhatsAppId: conexao.id, contaId: contaId }
             });
             console.log(`   🔄 Conversa criada para reação enviada: ${conversa.id}`);
          }

          // Salva a reação no banco
          await prisma.mensagem.create({
            data: {
              whatsappId: resultado.key.id,      // ID da própria reação
              conteudo: emoji,                   // O emoji
              tipo: 'REACAO',
              direcao: 'ENVIADA',                // Foi você quem enviou
              lida: true,                        // Reações enviadas são consideradas "lidas"
              status: 'enviada',                 // Status inicial
              reactionToWhatsappId: mensagemId,  // Link para o WA ID da msg original
              usuarioId: usuarioId,              // Quem enviou (usuário do sistema)
              timestamp: timestampMsg,
              conversaId: conversa.id,
              contaId: contaId,
              enviadaEm: dataMensagem,
              // Campos de reply/citação ficam null para reações
              replyParaId: null,
              mensagemCitadaAutor: null,
              mensagemCitadaConteudo: null,
              // Campos de participante (não se aplicam diretamente à reação em si, mas a quem enviou)
              remetenteNome: cliente.nome || 'Você', // Nome do usuário do sistema conectado
              participant: null, // Não há 'participante' específico para a reação enviada por você
              participantNome: null
            }
          });
          console.log(`   💾 Reação enviada salva no DB.`);

          // IMPORTANTE: Não atualizamos 'ultimaMensagemEm' da conversa com reações
          // await prisma.conversa.update({ where: { id: conversa.id }, data: { ultimaMensagemEm: dataMensagem } });

      } catch (dbError) {
          console.error(`❌ Erro ao salvar reação enviada no DB:`, dbError.message);
          // Não lança o erro para fora, pois a reação foi enviada com sucesso pelo WA
      }
      // --- FIM SALVAR NO DB ---

      return {
        sucesso: true,
        mensagem: 'Reação enviada',
        id: resultado.key.id // Retorna o ID da reação
      };

    } catch (erro) {
      console.error('❌ Erro geral ao enviar reação:', erro.message);
      // Log extra para depuração
      console.error(erro.stack);
      throw erro; // Lança o erro para o controlador lidar
    }
}
}

module.exports = new ServicoWhatsApp();
// --- FIM DO CÓDIGO ATUALIZADO ---